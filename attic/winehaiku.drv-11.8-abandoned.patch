+/* Window that currently holds the mouse capture, or NULL. */
+static HWND capture_hwnd;
+
+
+/**********************************************************************
+ *              window surface
+ *
+ * 11.x owns the backing bitmap, the lock and the dirty bounds in `struct
+ * window_surface` itself, so the driver only implements clipping, the blit and
+ * teardown -- the 7.8 driver`s lock/unlock/get_info/get_bounds/set_region
+ * entries no longer exist.
+ */
+
+static void haikudrv_surface_set_clip( struct window_surface *base, const RECT *rects, UINT count )
+{
+    /* The view hierarchy does the clipping on the Haiku side, so there is
+     * nothing to program here. */
+}
+
+static BOOL haikudrv_surface_flush( struct window_surface *base, const RECT *rect, const RECT *dirty,
+                                    const BITMAPINFO *color_info, const void *color_bits,
+                                    BOOL shape_changed, const BITMAPINFO *shape_info,
+                                    const void *shape_bits )
+{
+    int height = abs( color_info->bmiHeader.biHeight );
+    int stride;
+
+    if (!height) return TRUE;
+    stride = color_info->bmiHeader.biSizeImage / height;
+
+    haikudrv_window_blit( base->hwnd, color_bits, stride, rect, dirty );
+    return TRUE;
+}
+
+static void haikudrv_surface_destroy( struct window_surface *base )
+{
+    TRACE( "surface %p\n", base );
+}
+
+static const struct window_surface_funcs haikudrv_surface_funcs =
+{
+    haikudrv_surface_set_clip,
+    haikudrv_surface_flush,
+    haikudrv_surface_destroy,
+};
+
+static struct window_surface *create_surface( HWND hwnd, const RECT *rect )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *window_surface;
+    int width = rect->right - rect->left;
+    int height = rect->bottom - rect->top;
+
+    memset( info, 0, sizeof(*info) );
+    info->bmiHeader.biSize        = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth       = width;
+    info->bmiHeader.biHeight      = -height;  /* top-down */
+    info->bmiHeader.biPlanes      = 1;
+    info->bmiHeader.biBitCount    = 32;
+    info->bmiHeader.biSizeImage   = width * height * 4;
+    info->bmiHeader.biCompression = BI_RGB;
+
+    if (!(window_surface = window_surface_create( sizeof(struct window_surface),
+                                                  &haikudrv_surface_funcs, hwnd, rect, info, 0 )))
+        return NULL;
+
+    return window_surface;
+}
+
+/***********************************************************************
+ *              CreateWindowSurface   (HAIKUDRV.@)
+ */
+BOOL HAIKUDRV_CreateWindowSurface( HWND hwnd, BOOL layered, const RECT *surface_rect,
+                                   struct window_surface **surface )
+{
+    struct window_surface *previous;
+
+    TRACE( "hwnd %p, layered %u, surface_rect %s, surface %p\n", hwnd, layered,
+           wine_dbgstr_rect(surface_rect), surface );
+
+    if ((previous = *surface) && previous->funcs == &haikudrv_surface_funcs) return TRUE;
+    if (previous) window_surface_release( previous );
+
+    *surface = create_surface( hwnd, surface_rect );
+    return TRUE;
+}
+
+
+/**********************************************************************
+ *              window hooks
+ */
