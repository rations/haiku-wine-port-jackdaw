+	*supported = VK_TRUE;
+	return VK_SUCCESS;
+}
+
+static VkBool32 haikudrv_vkGetPhysicalDeviceWin32PresentationSupportKHR(VkPhysicalDevice physDev, uint32_t index)
+{
+	TRACE("()\n");
+	return VK_TRUE;
+}
+
+static VkResult VKAPI_CALL haikudrv_vkGetDeviceGroupSurfacePresentModesKHR(
