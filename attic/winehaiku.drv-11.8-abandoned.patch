+VKWineSwapchain::~VKWineSwapchain()
+{
+	if (fCommandPool != VK_NULL_HANDLE) {
+		vkDestroyCommandPool(fDevice, fCommandPool, nullptr);
+		vkQueueWaitIdle(fQueue);
+	}
+
+	vkDestroyFence(fDevice, fFence, NULL);
+	recursive_lock_destroy(&fLock);
+}
