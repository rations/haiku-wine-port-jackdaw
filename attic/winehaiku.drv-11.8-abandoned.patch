+
+/***********************************************************************
+ *           HAIKUDRV process initialisation routine
+ */
+static BOOL process_attach(void)
+{
+    if (!HaikuStartApplication()) return FALSE;
+    if (pthread_key_create( &thread_data_key, NULL )) return FALSE;
+    init_user_driver();
+    return TRUE;
+}
+
+
+/***********************************************************************
+ *           HAIKUDRV initialisation routine
+ */
+static NTSTATUS haikudrv_unix_init( void *arg )
+{
+    if (!process_attach()) return STATUS_UNSUCCESSFUL;
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    haikudrv_unix_init,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == haikudrv_unix_func_count );
