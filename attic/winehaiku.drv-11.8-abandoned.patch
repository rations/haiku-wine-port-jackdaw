+static void WriteSet(uint32 val)
+{
+	printf("{");
+	bool first = true;
+	for (uint32 i = 0; i < 32; i++) {
+		if ((1 << i) & val) {
+			if (first) first = false; else printf(", ");
+			printf("%" B_PRIu32, i);
+		}
+	}
+	printf("}");
+}
