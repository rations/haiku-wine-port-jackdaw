+
+/***********************************************************************
+ *      UpdateDisplayDevices  (HAIKUDRV.@)
+ *
+ * FIXME: the display geometry is still hardcoded, as it was in the 7.8 driver
+ *        this was rebased from.  The real values have to come from BScreen,
+ *        which lives on the C++ side of the driver -- see the note in
+ *        `window.cpp` about why this file cannot touch the BeAPI directly.
+ */
+UINT HAIKUDRV_UpdateDisplayDevices( const struct gdi_device_manager *device_manager,
+                                    void *param )
+{
+    static const struct pci_id pci_id = { 0 };
+    const RECT rect = { 0, 0, 1920, 1080 };
+    struct gdi_monitor monitor = { 0 };
+    DEVMODEW mode = { 0 };
+
+    TRACE( "\n" );
+
+    device_manager->add_gpu( "Haiku app_server", &pci_id, NULL, param );
+
+    device_manager->add_source( "Haiku",
+                                DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE,
+                                96 /* dpi */, param );
+
+    monitor.rc_monitor = rect;
+    monitor.rc_work = rect;
+    device_manager->add_monitor( &monitor, param );
+
+    mode.dmSize = sizeof(mode);
+    mode.dmFields = DM_DISPLAYORIENTATION | DM_PELSWIDTH | DM_PELSHEIGHT |
+                    DM_BITSPERPEL | DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY;
+    mode.dmDisplayOrientation = DMDO_DEFAULT;
+    mode.dmPelsWidth = rect.right - rect.left;
+    mode.dmPelsHeight = rect.bottom - rect.top;
+    mode.dmBitsPerPel = 32;
+    mode.dmDisplayFrequency = 60;
+    device_manager->add_modes( &mode, 1, &mode, param );
+
+    return STATUS_SUCCESS;
+}
