+VKWineSwapchain::VKWineSwapchain():
+	fLock(RECURSIVE_LOCK_INITIALIZER("VKWineSwapchain")),
+	fCommandPool(VK_NULL_HANDLE),
+	fFence(VK_NULL_HANDLE)
+{}
