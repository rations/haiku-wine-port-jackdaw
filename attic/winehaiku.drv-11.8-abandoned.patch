+//#pragma mark -
+
+
+thread_id sAppThread = -1;
+std::map<HWND, WineWindow*> *sWindows;
+
+static int32 AppThread(void *arg)
+{
+	rename_thread(find_thread(NULL), "application");
+	be_app->Lock();
+	be_app->Run();
+	return 0;
+}
+
+extern "C" BOOL HaikuStartApplication()
+{
+	if (be_app != NULL) {
+		ERR("be_app != NULL");
+		_exit(1);
+	}
+	
+	sWindows = new std::map<HWND, WineWindow*>();
+
+	new WineApplication();
+	be_app->Unlock();
+	/* FIXME: these loops are spawned with the Haiku thread API rather than
+	 *        CreateThread, which is unavailable to unix-side driver code.  They
+	 *        call back into Wine through the seam (haikudrv_send_input ->
+	 *        NtUserSendHardwareInput), and whether an unregistered Haiku thread
+	 *        may do that is UNVERIFIED -- winewayland.drv creates such threads
+	 *        on the PE side in dllmain.c for exactly this reason.  Check this
+	 *        first if input injection misbehaves. */
+	sAppThread = spawn_thread(AppThread, "application", B_NORMAL_PRIORITY, NULL);
+	if (sAppThread < B_OK) return FALSE;
+	resume_thread(sAppThread);
+	return TRUE;
+}
+
+static int32 WindowThread(void *arg)
+{
+	rename_thread(find_thread(NULL), "window");
+	auto wnd = (WineWindow*)arg;
+	wnd->Lock();
+	mutex_unlock(&wnd->fCreateMutex);
+	wnd->Loop();
+	return 0;
+}
+
+WineWindow* HaikuThisWindow(HWND hwnd, bool create)
+{
+	BAutolock lock(be_app);
+	auto it = sWindows->find(hwnd);
+	if (it != sWindows->end())
+		return it->second;
+	
+	if (!create)
+		return NULL;
+
+	//struct haikudrv_thread_data *data = haikudrv_init_thread_data();
+	WineWindow *window = new WineWindow(hwnd, NULL, BRect());
+	(*sWindows)[hwnd] = window;
+	mutex_lock(&window->fCreateMutex);
+	window->Unlock();
+	thread_id tid = spawn_thread(WindowThread, "window", B_NORMAL_PRIORITY, window);
+	if (tid >= B_OK) resume_thread(tid);
+	mutex_lock(&window->fCreateMutex);
+	return window;
+}
+
+static void HaikuRemoveWindow(HWND hwnd)
+{
+	BAutolock lock(be_app);
+	auto it = sWindows->find(hwnd);
+	if (it == sWindows->end()) {
+		ERR("hwnd %p not present in host window list\n", hwnd);
+	}
+	sWindows->erase(it);
+}
+
+
+/* Per-thread data for the C++ half.  The Wine half keeps its own pthread key;
+ * this one is private here so that window.cpp need not include haikudrv.h. */
+static pthread_key_t sThreadDataKey;
+static pthread_once_t sThreadDataKeyOnce = PTHREAD_ONCE_INIT;
+
+static void MakeThreadDataKey(void)
+{
+    pthread_key_create( &sThreadDataKey, NULL );
+}
+
+struct haikudrv_thread_data *haikudrv_init_thread_data(void)
+{
+    pthread_once( &sThreadDataKeyOnce, MakeThreadDataKey );
+
+    struct haikudrv_thread_data *data =
+        (struct haikudrv_thread_data *)pthread_getspecific( sThreadDataKey );
+    if (data) return data;
+
+    if (!(data = new(std::nothrow) struct haikudrv_thread_data()))
+    {
+        ERR( "could not create data\n" );
+        return NULL;
+    }
+
+    pthread_setspecific( sThreadDataKey, data );
+    return data;
+}
+
+//#pragma mark -
+
+
+static void GetHaikuWindowFlags(
+	uint32 &flags,
+	window_look &look,
+	window_feel &feel,
+	WineWindow *wnd,
+	DWORD style, DWORD ex_style,
+	const RECT *window_rect,
+	const RECT *client_rect
+)
+{
+    flags = B_NOT_CLOSABLE | B_NOT_MINIMIZABLE | B_NOT_ZOOMABLE | B_NOT_RESIZABLE |
+    	B_ASYNCHRONOUS_CONTROLS | B_WILL_ACCEPT_FIRST_CLICK;
+    look = B_NO_BORDER_WINDOW_LOOK;
+    feel = B_NORMAL_WINDOW_FEEL;
+
+    //if (disable_window_decorations) return;
+    if (IsRectEmpty(window_rect)) return;
+    if (EqualRect(window_rect, client_rect)) return;
+
+    if ((style & WS_CAPTION) == WS_CAPTION && !(ex_style & WS_EX_LAYERED))
+    {
+        look = B_MODAL_WINDOW_LOOK;
+        if (true/*!data->shaped*/)
+        {
+            look = B_TITLED_WINDOW_LOOK;
+            if (style & WS_SYSMENU) flags &= ~B_NOT_CLOSABLE;
+            if (style & WS_MINIMIZEBOX) flags &= ~B_NOT_MINIMIZABLE;
+            if (style & WS_MAXIMIZEBOX) flags &= ~B_NOT_ZOOMABLE;
+            if (ex_style & WS_EX_TOOLWINDOW) look = B_FLOATING_WINDOW_LOOK;
+        }
+    }
+    if (style & WS_THICKFRAME)
+    {
+        if (look == B_NO_BORDER_WINDOW_LOOK) look = B_MODAL_WINDOW_LOOK;
+        if (true/*!data->shaped*/) flags &= ~B_NOT_RESIZABLE;
+    }
+    else if (ex_style & WS_EX_DLGMODALFRAME) {if (look == B_NO_BORDER_WINDOW_LOOK) look = B_MODAL_WINDOW_LOOK;}
+    else if ((style & (WS_DLGFRAME|WS_BORDER)) == WS_DLGFRAME) {if (look == B_NO_BORDER_WINDOW_LOOK) look = B_MODAL_WINDOW_LOOK;}
+    else if ((style & (WS_DLGFRAME|WS_BORDER)) == WS_BORDER) {if (look == B_NO_BORDER_WINDOW_LOOK) look = B_BORDERED_WINDOW_LOOK;}
+}
+
+
+/*****************************************************************
+ *		SetWindowText   (HAIKUDRV.@)
+ */
+
+
+/**********************************************************************
+ *              the C <-> BeAPI seam
+ *
+ * Everything below is called from the Wine half (window.c) through
+ * haikudrv_be.h.  Nothing here may reference Wine`s unix-side headers.
+ */
+
+extern "C" BOOL haikudrv_window_create( HWND hwnd )
+{
+    return HaikuThisWindow( hwnd, true ) != NULL;
+}
+
+extern "C" void haikudrv_window_destroy( HWND hwnd )
+{
+    WineWindow *wnd = HaikuThisWindow( hwnd, false );
+    if (wnd == NULL) return;
+
+    wnd->Lock();
+    wnd->fInDestroy = true;
+    BMessenger( wnd ).SendMessage( B_QUIT_REQUESTED );
+    wnd->Unlock();
+    HaikuRemoveWindow( hwnd );
+}
+
+extern "C" void haikudrv_window_set_title( HWND hwnd, const char *utf8 )
+{
+    WineWindow *wnd = HaikuThisWindow( hwnd, false );
+    if (wnd == NULL) return;
+
+    wnd->Lock();
+    wnd->SetTitle( utf8 );
+    wnd->Unlock();
+}
+
+extern "C" void haikudrv_window_activate( HWND hwnd )
+{
+    WineWindow *wnd = HaikuThisWindow( hwnd, false );
+    if (wnd == NULL) return;
+
+    wnd->Activate();
+}
+
+extern "C" void haikudrv_window_set_capture( HWND prev, HWND next )
+{
+    WineWindow *prev_wnd = prev ? HaikuThisWindow( prev, false ) : NULL;
+    WineWindow *next_wnd = next ? HaikuThisWindow( next, false ) : NULL;
+
+    if (prev_wnd != NULL) {
+        prev_wnd->Lock();
+        prev_wnd->View()->SetEventMask( 0 );
+        prev_wnd->Unlock();
+    }
+    if (next_wnd != NULL) {
+        next_wnd->Lock();
+        next_wnd->View()->SetEventMask( B_POINTER_EVENTS | B_KEYBOARD_EVENTS );
+        next_wnd->Unlock();
+    }
+}
+
+extern "C" void haikudrv_window_pos_changed( HWND hwnd, const RECT *window_rect,
+                                             const RECT *client_rect,
+                                             const RECT *visible_rect,
+                                             DWORD style, DWORD ex_style,
+                                             UINT swp_flags )
+{
+    WineWindow *window = HaikuThisWindow( hwnd, false );
+    if (window == NULL) return;
+
+    window->Lock();
+
+    window->fNonClient = {
+        visible_rect->left - window_rect->left,
+        visible_rect->top  - window_rect->top,
+        window_rect->right  - visible_rect->right,
+        window_rect->bottom - visible_rect->bottom
+    };
+    window->MoveTo( visible_rect->left, visible_rect->top );
+    window->ResizeTo( visible_rect->right - visible_rect->left - 1,
+                      visible_rect->bottom - visible_rect->top - 1 );
+
+    uint32 new_flags;
+    window_look new_look;
+    window_feel new_feel;
+    GetHaikuWindowFlags( new_flags, new_look, new_feel, window, style, ex_style,
+                         window_rect, client_rect );
+    if (window->Flags() != new_flags) window->SetFlags( new_flags );
+    if (window->Look() != new_look) window->SetLook( new_look );
+    if (window->Feel() != new_feel) window->SetFeel( new_feel );
+
+    bool new_visible = (style & WS_VISIBLE) != 0;
+    if (new_visible != !window->IsHidden()) {
+        if (new_visible) {
+            /* B_AVOID_FOCUS is toggled around Show() so that showing a window
+             * without SWP_NOACTIVATE does not steal focus. */
+            if (SWP_NOACTIVATE & swp_flags) window->SetFlags( window->Flags() | B_AVOID_FOCUS );
+            window->Show();
+            if (SWP_NOACTIVATE & swp_flags) window->SetFlags( window->Flags() & ~B_AVOID_FOCUS );
+            window->fSendResizeEvents = true;
+        } else {
+            window->Hide();
+            window->fSendResizeEvents = false;
+        }
+    } else if (!window->IsHidden() && !(SWP_NOACTIVATE & swp_flags)) {
+        window->Activate();
+    }
+
+    window->Unlock();
+}
+
+extern "C" void haikudrv_window_blit( HWND hwnd, const void *bits, int stride,
+                                      const RECT *rect, const RECT *dirty )
+{
+    WineWindow *window = HaikuThisWindow( hwnd, false );
+    if (window == NULL || bits == NULL) return;
+
+    int width = rect->right - rect->left;
+    int height = rect->bottom - rect->top;
+    if (width <= 0 || height <= 0) return;
+
+    /* The surface memory belongs to win32u and may be reused as soon as this
+     * returns, so the pixels are copied into a BBitmap the view owns. */
+    BBitmap *bitmap = new BBitmap( BRect( 0, 0, width - 1, height - 1 ), B_RGB32 );
+    if (bitmap->InitCheck() != B_OK) {
+        delete bitmap;
+        return;
+    }
+
+    const uint8 *src = (const uint8 *)bits;
+    uint8 *dst = (uint8 *)bitmap->Bits();
+    int32 dst_stride = bitmap->BytesPerRow();
+    for (int y = 0; y < height; y++)
+        memcpy( dst + (int32)y * dst_stride, src + (int32)y * stride, (size_t)width * 4 );
+
+    BRect dirty_rect( dirty->left - rect->left, dirty->top - rect->top,
+                      dirty->right - rect->left - 1, dirty->bottom - rect->top - 1 );
+
+    window->Lock();
+    window->View()->UpdateBitmap( bitmap, dirty_rect );
+    window->Unlock();
+}
+
+extern "C" int haikudrv_key_to_utf8( UINT virt_key, const BYTE *key_state,
+                                     char *buf, int buf_size )
+{
+    if (virt_key >= 256) return 0;
+
+    uint32 key = sHaikuFromVkKeycodes[virt_key];
+    uint32 modifiers = HaikuModifiersFromKeyState( key_state );
+
+    char *chars = NULL;
+    size_t len = 0;
+    MapKey( chars, len, key, modifiers );
+    if (chars == NULL || len == 0 || (int)len > buf_size) return 0;
+
+    memcpy( buf, chars, len );
+    return (int)len;
+}
