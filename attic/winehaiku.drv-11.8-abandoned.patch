+    return TRUE;
+}
+
+/***********************************************************************
+ *              SetWindowText   (HAIKUDRV.@)
+ */
+void HAIKUDRV_SetWindowText( HWND hwnd, LPCWSTR text )
+{
+    DWORD len = 0, written = 0;
+    char *utf8;
+
+    if (!text) return;
+
+    /* The sizing call reports a non-success status by design; only `len` matters.
+     * Same pattern as winex11.drv`s SetWindowText. */
+    RtlUnicodeToUTF8N( NULL, 0, &len, text, lstrlenW( text ) * sizeof(WCHAR) );
+    if (!(utf8 = malloc( len + 1 ))) return;
+    if (!RtlUnicodeToUTF8N( utf8, len, &written, text, lstrlenW( text ) * sizeof(WCHAR) ))
+    {
+        utf8[written] = 0;
+        haikudrv_window_set_title( hwnd, utf8 );
+    }
+    free( utf8 );
+}
+
+/***********************************************************************
+ *              ActivateWindow   (HAIKUDRV.@)
