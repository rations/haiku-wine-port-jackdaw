+void HAIKUDRV_ActivateWindow( HWND hwnd, HWND previous )
+{
+    TRACE( "hwnd %p, previous %p\n", hwnd, previous );
+    haikudrv_window_activate( hwnd );
+}
+
+/***********************************************************************
+ *              SetCapture   (HAIKUDRV.@)
+ */
