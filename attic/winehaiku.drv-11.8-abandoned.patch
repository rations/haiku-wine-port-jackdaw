+ * NOTE: the loose RECT parameters became `struct window_rects`, and surface
+ *       creation moved out of here into CreateWindowSurface.
+ */
+BOOL HAIKUDRV_WindowPosChanging( HWND hwnd, UINT swp_flags, BOOL shaped,
+                                 const struct window_rects *rects )
+{
+    TRACE( "hwnd %p, swp_flags %#x, shaped %u\n", hwnd, swp_flags, shaped );
+    return TRUE;
+}
+
+/***********************************************************************
+ *              WindowPosChanged   (HAIKUDRV.@)
+ */
+void HAIKUDRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags,
+                                const struct window_rects *rects, struct window_surface *surface )
+{
+    DWORD style, ex_style;
+
+    if (!rects) return;
+
+    style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+    ex_style = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE );
+
+    haikudrv_window_pos_changed( hwnd, &rects->window, &rects->client, &rects->visible,
+                                 style, ex_style, swp_flags );
+}
+
+/***********************************************************************
+ *              ToUnicodeEx   (HAIKUDRV.@)
+ */
+INT HAIKUDRV_ToUnicodeEx( UINT virt_key, UINT scan_code, const BYTE *key_state,
+                          LPWSTR buf, int buf_size, UINT flags, HKL hkl )
+{
+    char utf8[16];
+    DWORD written = 0;
+    int len;
+
+    if (!(len = haikudrv_key_to_utf8( virt_key, key_state, utf8, sizeof(utf8) ))) return 0;
+
+    if (RtlUTF8ToUnicodeN( buf, buf_size * sizeof(WCHAR), &written, utf8, len )) return 0;
+    return written / sizeof(WCHAR);
+}
+
+/***********************************************************************
+ *              haikudrv_send_input
+ *
+ * The C++ half cannot call NtUserSendHardwareInput -- it is a static inline in
+ * ntuser.h, which does not compile as C++ -- so input injection comes back
+ * through here.
